  <library name="NEXPT Video">
    <event name="NEXPT Keynote">
      <project name="NEXPT Work — Keynote-Film">
        <sequence format="r1" duration="440100/3000s" tcStart="0s" tcFormat="NDF"
                  audioLayout="stereo" audioRate="48k">
          <spine>
            <asset-clip ref="a1" offset="0/3000s" name="00a_wirsind" start="0s" duration="8700/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 0 Wer wir sind · 00a_wirsind"/><marker start="0s" duration="100/3000s" value="VO: Wir sind Raphael und Christian Heusser."/></asset-clip>
            <asset-clip ref="a2" offset="8700/3000s" name="00b_warum" start="0s" duration="13500/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 0 Wer wir sind · 00b_warum"/><marker start="0s" duration="100/3000s" value="VO: Wir haben NEXPT gestartet, damit du arbeiten kannst."/></asset-clip>
            <asset-clip ref="a3" offset="22200/3000s" name="01_versprechen" start="0s" duration="9600/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 1 Selbstkorrektur · 01_versprechen"/><marker start="0s" duration="100/3000s" value="VO: Und wir haben ein Versprechen. Und eine Meinung."/></asset-clip>
            <asset-clip ref="a4" offset="31800/3000s" name="02_flip" start="0s" duration="7500/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 1 Selbstkorrektur · 02_flip"/><marker start="0s" duration="100/3000s" value="VO: Arbeite so, wie wir es vorsehen —"/><marker start="2700/3000s" duration="100/3000s" value="BG → accent"/></asset-clip>
            <asset-clip ref="a5" offset="39300/3000s" name="03_moment" start="0s" duration="9600/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 1 Selbstkorrektur · 03_moment"/><marker start="0s" duration="100/3000s" value="VO: Moment. Nein. Das machen alle anderen."/></asset-clip>
            <asset-clip ref="a6" offset="48900/3000s" name="04_ihr" start="0s" duration="10200/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 1 Selbstkorrektur · 04_ihr"/><marker start="0s" duration="100/3000s" value="VO: Arbeite so, wie du willst."/></asset-clip>
            <asset-clip ref="a7" offset="59100/3000s" name="05_aside" start="0s" duration="4200/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 1 Selbstkorrektur · 05_aside"/><marker start="0s" duration="100/3000s" value="VO: (ja, auch du in der Buchhaltung)"/></asset-clip>
            <asset-clip ref="a8" offset="63300/3000s" name="06_wege" start="0s" duration="24000/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 2 Freiheit · 06_wege"/><marker start="0s" duration="100/3000s" value="VO: Du planst in Sprints. Du in Phasen. Du in Tickets. Du in Fristen. Du in Schichten. Du in Etappen."/></asset-clip>
            <asset-clip ref="a9" offset="87300/3000s" name="07_niemand" start="0s" duration="7800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 2 Freiheit · 07_niemand"/><marker start="0s" duration="100/3000s" value="VO: Niemand muss sich umgewöhnen. Niemand."/></asset-clip>
            <asset-clip ref="a10" offset="95100/3000s" name="08_broll" start="0s" duration="13800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 2 Freiheit · 08_broll"/><marker start="0s" duration="100/3000s" value="VO: (kein Text — drei Makro-Einstellungen)"/></asset-clip>
            <asset-clip ref="a11" offset="108900/3000s" name="09_flut" start="0s" duration="12000/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 2 Freiheit · 09_flut"/><marker start="0s" duration="100/3000s" value="VO: Wir nennen es, wie ihr es nennt."/></asset-clip>
            <asset-clip ref="a12" offset="120900/3000s" name="10_eure" start="0s" duration="7800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 2 Freiheit · 10_eure"/><marker start="0s" duration="100/3000s" value="VO: Eure Wörter. Nicht unsere."/></asset-clip>
            <asset-clip ref="a13" offset="128700/3000s" name="10b_eures" start="0s" duration="12000/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 2 Freiheit · 10b_eures"/><marker start="0s" duration="100/3000s" value="VO: Und eure Reihenfolge. Eure Regeln. Euer Tempo."/></asset-clip>
            <asset-clip ref="a14" offset="140700/3000s" name="11a_menschen" start="0s" duration="13800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 3 Die Leute · 11a_menschen"/><marker start="0s" duration="100/3000s" value="VO: Weil hier nicht das Projekt arbeitet. Sondern Menschen."/></asset-clip>
            <asset-clip ref="a15" offset="154500/3000s" name="11b_rollen" start="0s" duration="27000/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 3 Die Leute · 11b_rollen"/><marker start="0s" duration="100/3000s" value="VO: Die Bauleiterin sieht ihre Etappe. Der Servicetechniker seine Tickets. Die Treuhänderin ihre Frist. Die Geschäftsführerin sieht alles."/></asset-clip>
            <asset-clip ref="a16" offset="181500/3000s" name="11c_trick" start="0s" duration="4800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 3 Die Leute · 11c_trick"/><marker start="0s" duration="100/3000s" value="VO: (das ist der Trick)"/></asset-clip>
            <asset-clip ref="a17" offset="186300/3000s" name="12a_chaos" start="0s" duration="7800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 4 Einwand · 12a_chaos"/><marker start="0s" duration="100/3000s" value="VO: Vier Sichtweisen. Ein Chaos?"/></asset-clip>
            <asset-clip ref="a18" offset="194100/3000s" name="12_nein" start="0s" duration="4800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 3 Einwand · 12_nein"/><marker start="0s" duration="100/3000s" value="VO: NEIN."/></asset-clip>
            <asset-clip ref="a19" offset="198900/3000s" name="13_modell" start="0s" duration="19800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 4 Ein Modell · 13_modell"/><marker start="0s" duration="100/3000s" value="VO: Oben ist eure Sprache. Unten ist ein Standard."/></asset-clip>
            <asset-clip ref="a20" offset="218700/3000s" name="13b_stufen" start="0s" duration="22400/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 5 Ein Standard · 13b_stufen"/><marker start="0s" duration="100/3000s" value="VO: Fünf Stufen. Mehr braucht Arbeit nicht. Egal ob Bau, Betrieb oder Buchhaltung — darunter liegt dasselbe Modell."/></asset-clip>
            <asset-clip ref="a21" offset="241100/3000s" name="14_ende" start="0s" duration="10800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 5 Übergang · 14_ende"/><marker start="0s" duration="100/3000s" value="VO: Und irgendwann ist das Projekt fertig. Die Arbeit nicht."/></asset-clip>
            <asset-clip ref="a22" offset="251900/3000s" name="15_element" start="0s" duration="15600/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 5 Übergang · 15_element"/><marker start="0s" duration="100/3000s" value="VO: Dasselbe Element. Neuer Modus. Kein neues Tool."/></asset-clip>
            <asset-clip ref="a23" offset="267500/3000s" name="16_pfeile" start="0s" duration="16000/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 5 Übergang · 16_pfeile"/><marker start="0s" duration="100/3000s" value="VO: Hunderte von Tickets, Stunden, Fristen, Freigaben, Änderungen."/></asset-clip>
            <asset-clip ref="a24" offset="283500/3000s" name="17_hundert" start="0s" duration="12200/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 5 Übergang · 17_hundert"/><marker start="0s" duration="100/3000s" value="VO: Hundert Prozent verbunden. Kein Export. Null Doppelerfassung."/></asset-clip>
            <asset-clip ref="a25" offset="295700/3000s" name="18_aendert" start="0s" duration="8400/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 6 Korrektur · 18_aendert"/><marker start="0s" duration="100/3000s" value="VO: Und wenn jemand etwas ändert?"/></asset-clip>
            <asset-clip ref="a26" offset="304100/3000s" name="19_alle" start="0s" duration="7800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 6 Korrektur · 19_alle"/><marker start="0s" duration="100/3000s" value="VO: Sehen es alle. Sofort."/></asset-clip>
            <asset-clip ref="a27" offset="311900/3000s" name="19b_keine" start="0s" duration="13800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 7 Korrektur · 19b_keine"/><marker start="0s" duration="100/3000s" value="VO: Keine Rundmail. Kein Statusbericht. Kein Nachfragen."/></asset-clip>
            <asset-clip ref="a28" offset="325700/3000s" name="20_transparenz" start="0s" duration="10000/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 6 Korrektur · 20_transparenz"/><marker start="0s" duration="100/3000s" value="VO: Transparenz ist kein Bericht. Sie ist ein Nebeneffekt."/></asset-clip>
            <asset-clip ref="a29" offset="335700/3000s" name="21_allein" start="0s" duration="7800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 7 Gegner · 21_allein"/><marker start="0s" duration="100/3000s" value="VO: Aber Struktur allein ist noch keine Übersicht."/></asset-clip>
            <asset-clip ref="a30" offset="343500/3000s" name="22_raster" start="0s" duration="13800/3000s" format="r1" tcFormat="NDF"><marker start="0s" duration="100/3000s" value="Akt 7 Gegner · 22_raster"/><marker start="0s" duration="100/3000s" value="VO: Die meisten nennen Übersicht: eine Tabelle."/></asset-clip>
