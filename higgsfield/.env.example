# Create server-side credentials in https://cloud.higgsfield.ai/
HIGGSFIELD_API_KEY_ID=replace-me
HIGGSFIELD_API_KEY_SECRET=replace-me

# Seedance 2.0 is available in Higgsfield's official CLI, but the public REST
# OpenAPI schema currently does not publish a fixed Seedance 2.0 path. Enter
# the endpoint enabled for your API account; never guess or use a browser URL.
HIGGSFIELD_SEEDANCE_ENDPOINT=/endpoint-provided-by-higgsfield

HIGGSFIELD_OUTPUT_DIR=out/higgsfield
HIGGSFIELD_REQUEST_TIMEOUT_SECONDS=30
HIGGSFIELD_GENERATION_TIMEOUT_SECONDS=1800
