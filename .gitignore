# ProRes-Master: 267 MB, wird lokal mit `python3 render/render.py` neu erzeugt
__pycache__/
out/scenes/
out/_frames/
out/_vo/
out/_xtts/
out/_qwen/
# Piper-Stimmmodelle (~200 MB) — mit render/voices/get-voices.sh laden
render/voices/*.onnx

# Download-Paket: bündelt nur, was ohnehin im Repo liegt — mit paket.sh neu bauen
out/*.zip

# Lizenzierter Musiktrack — gehoert nicht ins Repo, liegt beim Lizenznehmer.
# Auch der Schnitt daraus: out/music.wav ist der Track fast unveraendert, nur
# gekuerzt. Er wird mit `python3 render/musik.py` neu erzeugt. Die fertigen
# Mischungen bleiben drin — dort liegt die Stimme darueber, sie sind das
# Arbeitsergebnis und nicht der Track.
out/_musik/
out/music.wav

# Reproduzierbare Original-Audio-Renderings. Die Generatoren und kleinen
# JSON-Manifeste gehoeren ins Repo, die grossen WAV/MP4-Ausgaben nicht.
out/music-original.wav
out/sfx-original.wav
out/sfx-impacts.wav
out/sfx-motion.wav
out/sfx-ui.wav
out/audio-rework-preview.wav
out/audio-rework-preview.m4a
out/NEXPT-AUDIO-REWORK-PREVIEW.mp4

# Lokale Referenzanalyse. Die Referenz selbst wird nie kopiert; Profil,
# synthetisches Kit und Renderings sind reproduzierbare, benutzerspezifische
# Ausgaben und gehoeren nicht in das oeffentliche Repository.
out/analysis/reference-*.json
out/analysis/music-reference*.json
out/analysis/candidate-*.json
out/reference-kit*/
out/music-reference*.wav
out/music-reference*.m4a
out/music-reference*.mp3
out/music-garageband.wav
out/reference-audio-preview.wav
out/reference-audio-preview.m4a
out/NEXPT-REFERENCE-AUDIO-PREVIEW*.mp4

# Sicherungskopie von takt.py — der Stand davor steht ohnehin in der Historie
render/timing.json.vor-takt

# Echte Trommeln (VCSL, CC0) — 73 MB, mit `python3 render/vcsl.py` wieder da
out/_vcsl/

# Groove MIDI Dataset (Magenta, CC BY 4.0) — mit `python3 render/groove.py --laden`
out/_groove/

# GarageBand-Projekte und Exporte — auf dem Mac erzeugt, gross, reproduzierbar.
# Die Partituren (garageband/scores/) gehoeren dagegen ins Repo.
garageband/arrangements/*
!garageband/arrangements/.gitkeep

# Mac-, GarageBand-Version-, Sprach- und Sound-Pack-spezifisches Inventar.
# Mit `python3 garageband/session.py inventory` auf dem Ziel-Mac neu erzeugen.
garageband/catalogs/*.json
